/* ═══════════════════════════════════════════════════════════════════════
   PANELS (help)
   ═══════════════════════════════════════════════════════════════════════ */

/* As tall as the window allows, so Help fits a small pop-up */
PanelScreen > Vertical {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

PanelScreen Static {
    color: $fg;
}

PanelScreen .section-title {
    text-style: bold;
    color: $fg;
    border-bottom: ascii $gutter;
}

/* As wide as the two columns, so the panel sizes to its shortcuts */
PanelScreen #shortcuts-sections {
    width: auto;
    height: auto;
}

PanelScreen .shortcuts-section {
    height: auto;
}

/* As wide as their longest line, so no description is cut */
PanelScreen #shortcuts-actions {
    width: auto;
    margin-right: 4;
}

PanelScreen #shortcuts-general {
    width: auto;
}

PanelScreen .shortcut-row {
    width: auto;
    height: 1;
}

PanelScreen .shortcut-key {
    width: 8;
    color: $green;
}

PanelScreen .shortcut-desc {
    width: auto;
    color: $fg;
}

PanelScreen #panel-footer-spacer {
    height: 1;
}

/* As wide as the panel the shortcuts sized, not the whole window */
PanelScreen #panel-footer {
    width: 100%;
    height: 1;
    align: left middle;
}

PanelScreen #panel-footer .spacer {
    width: 1fr;
}

/* Neutral, like a dialog's cancel button: closing is neither an action nor a danger */
PanelScreen #btn-close {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

PanelScreen #btn-close:hover {
    background: $gutter;
}

PanelScreen #btn-close:focus {
    background: $comment;
    color: $bg-dark;
    text-style: bold;
}

PanelScreen #panel-version {
    width: auto;
    margin-left: 1;
    color: $comment;
}

PanelScreen #panel-repository {
    width: auto;
    color: $blue;
    background: transparent;
}

PanelScreen #panel-repository:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}
