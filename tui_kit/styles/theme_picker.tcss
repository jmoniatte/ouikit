/* ═══════════════════════════════════════════════════════════════════════
   THEME PICKER
   ═══════════════════════════════════════════════════════════════════════ */

ThemePicker #theme-picker {
    width: 54;
    height: 1fr;
    max-height: 100%;
    /* Textual sets every side of the margin at once, so the top repeats base.tcss's one row */
    margin: 1 0;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

ThemePicker #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

ThemePicker #theme-filter {
    width: 1fr;
    height: 2;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
    color: $fg;
    border: none !important;
    border-bottom: solid $gutter !important;
}

ThemePicker #theme-filter:focus {
    border-bottom: solid $blue !important;
}

ThemePicker #theme-table {
    height: 1fr;
    background: transparent;
    border: none;
    color: $fg;
    scrollbar-size: 0 0;
}

ThemePicker #theme-table > .datatable--cursor {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

ThemePicker #theme-table > .datatable--hover {
    background: transparent;
}

ThemePicker #theme-hint {
    color: $comment;
    margin-top: 1;
    border-top: ascii $gutter;
    padding-top: 1;
}
